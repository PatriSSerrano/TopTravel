# Copia este archivo como .env y rellena tus datos de Travelpayouts.
# .env nunca se sirve en la web ni debe subirse a internet.
TRAVELPAYOUTS_TOKEN=

# Persona de contacto que aparece en las páginas legales.
CONTACT_EMAIL=

# Correo para enviar los avisos de precio. Sin SMTP_HOST solo se ven dentro de la web.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SITE_URL=

# Dejar de usar un servicio sin tocar el código: pon off.
HOTEL_PRICES=on
NOMINATIM=on

# Gráfico y recomendación en Guardados: on cuando el historial tenga datos suficientes.
PRICE_INSIGHTS=off
